OPENAI_API_KEY=your_key_here

# Leave blank to use real OpenAI. see below to set it to real providers. this is nice since if one agents quota 
# gets over we can use another one
#   https://api.groq.com/openai/v1
#   https://api.mistral.ai/v1
#   https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional override — model names change often, check your provider's
# current list rather than assuming this default still exists later.
NOVA_MODEL=gpt-5

# its not rlllyy necessary but include krlo toh accha hai. Lets search_web give a real spoken summary, not just open a
# browser tab. Free key at tavily.com. Leave blank to skip the summary.
TAVILY_API_KEY=
#weather
OPENWEATHER_API_KEY=
#news
GNEWS_API_KEY=

